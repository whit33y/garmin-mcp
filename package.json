{
  "name": "garmin-personal-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal multisport training and recovery MCP server for Garmin Connect",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:http": "node src/index.js --http",
    "demo": "node src/index.js --demo",
    "demo:http": "node src/index.js --demo --http",
    "test": "node --test",
    "check": "node scripts/check.js",
    "setup": "node scripts/setup.js",
    "verify:garmin": "node scripts/verify-garmin.js",
    "config:claude": "node scripts/claude-config.js",
    "plugin:build": "node scripts/build-plugin.js",
    "plugin:build:claude": "node scripts/build-claude-extension.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.1.0",
    "jose": "^6.2.13",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "fflate": "^0.8.3"
  }
}
