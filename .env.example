# Never commit a real key. Run npm run setup for a hidden local prompt.
GARMIN_API_KEY=
GARMIN_REGION=com
TIME_ZONE=Europe/Warsaw
DATA_DIR=./data
# HTTP: local by default. Remote HTTPS and OAuth are configured in README.md.
HOST=127.0.0.1
PORT=3000
MCP_ACCESS_TOKEN=
# Exact comma-separated browser origins, only if needed.
ALLOWED_ORIGINS=
# Optional OAuth provider issuer and externally visible MCP URL (see README).
OAUTH_ISSUER=
MCP_PUBLIC_URL=
OAUTH_SUBJECT=
# Audience defaults to MCP_PUBLIC_URL. Provider must issue signed JWT access tokens.
OAUTH_AUDIENCE=
OAUTH_SCOPE=mcp
